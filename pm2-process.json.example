{
	"name": "agent-miner",
	"interpreter": "/usr/bin/env",
	"script": "python",
	"args": "-u -m src.miner",
	"env": {
		"PYTHONUNBUFFERED": "1"
	},
	"min_uptime": 5000,
	"max_restarts": 3,
	"watch": [
		"./src/miner"
	],
	"ignore_watch": [
		"**/__pycache__/**",
		"**/node_modules/**",
		"**/*._*",
		"**/*.DS_Store",
		"**/*.pyc",
		"**/*.log",
		"**/*.bak",
		"**/*Thumbs.db"
	],
	"watch_options": {
		"followSymlinks": false
	}
}
